# Copy this file to .env (git-ignored). Task loads .env for every task.
# Local development needs no changes: `task wso2:up` and `task testacc:local` use the
# Docker server with admin/admin.

# --- Acceptance tests against any server (task testacc) -------------------------
# Without WSO2IS_BASE_URL, task testacc uses https://$WSO2_HOSTNAME (the lab below).
# WSO2IS_BASE_URL=https://localhost:9443
# WSO2IS_USERNAME=admin
# WSO2IS_PASSWORD=admin
# WSO2IS_INSECURE_SKIP_VERIFY=true
#
# A second JDBC user store database that the *server* can reach. Without it, the user
# store tests create an H2 store and skip adding users to it.
# WSO2IS_TEST_JDBC_URL=jdbc:postgresql://postgres:5432/WSO2_TEST_USERSTORE_DB
# WSO2IS_TEST_JDBC_DRIVER=org.postgresql.Driver
# WSO2IS_TEST_JDBC_USERNAME=wso2
# WSO2IS_TEST_JDBC_PASSWORD=change-me

# --- Hetzner lab (task lab:*, deploy/README.md) -----------------------------------
# Hetzner Cloud API token with read and write access to the lab project.
HCLOUD_TOKEN=
# Existing DNS zone in the same Hetzner project, and the subdomain for the lab.
# The lab server answers for <subdomain>.<zone> and every name below it.
LAB_DNS_ZONE=example.com
LAB_SUBDOMAIN=lab
# SSH key that may log in to the server as root (the .pub file must sit next to it).
# LAB_SSH_KEY=/home/you/.ssh/id_ed25519
# Public host name of WSO2 Identity Server. It must be below the lab domain.
WSO2_HOSTNAME=wso2is.lab.example.com
WSO2_ADMIN_USERNAME=admin
WSO2_ADMIN_PASSWORD=change-me
WSO2_DB_USERNAME=wso2
WSO2_DB_PASSWORD=change-me
WSO2_TLS_KEYSTORE_PASSWORD=change-me
WSO2_AUTH_ENDPOINT_APP_PASSWORD=change-me

# --- Release signing (maintainers only, RELEASING.md) -----------------------------
# GPG_FINGERPRINT=
# PASSPHRASE=
# Base64 of the ASCII-armored private key, on one line.
# GPG_PRIVATE_KEY=
